WWEBJS_TEST_REMOTE_ID=XXXXXXXXXX@c.us
WWEBJS_TEST_CLIENT_ID=authenticated

# Deploy do chat-app com docker compose (veja chat-app/DEPLOY.md)
APP_USER=admin
APP_PASSWORD=troque-por-uma-senha-forte
# Domínio para HTTPS (opcional). Sem domínio próprio, use o IP do servidor com sslip.io,
# por exemplo 129-146-10-20.sslip.io para o IP 129.146.10.20.
DOMAIN=
# Com HTTPS ativo, troque para 127.0.0.1:3000 para não expor a porta sem criptografia.
CHAT_PORT=3000
# Endereços extras aceitos pelo chat, separados por vírgula, quando um proxy reescreve o Host
# (o Codespaces já é detectado sozinho). Ex.: ALLOWED_ORIGINS=https://chat.exemplo.com
ALLOWED_ORIGINS=
